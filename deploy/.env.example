REDIS_URL=redis://redis:6379
OCULAR_TOKEN=change-me-to-a-strong-random-token

# Mot de passe Redis. VIDE = aucune authentification (comportement historique).
# Redis porte les secrets de session EN CLAIR : poser une valeur ici active
# `requirepass` côté serveur ET l'AUTH côté web/broker en une seule fois.
# OCULAR_REDIS_PASSWORD=change-me-to-a-strong-random-password

# GID du socket Docker SUR CET HÔTE. Le broker tourne en uid non-root (10002) et
# obtient l'accès à /var/run/docker.sock par ce groupe supplémentaire.
# ⚠️ OBLIGATOIRE si le GID de ton hôte n'est pas 999 (le défaut du compose) :
#     stat -c '%g' /var/run/docker.sock
# Mauvaise valeur = le broker perd Docker et les sessions interactives échouent
# (échec bruyant, pas de retour silencieux à root).
OCULAR_DOCKER_GID=999

# Interface d'écoute de l'API. Défaut sûr = loopback SEULEMENT.
# L'API (/sessions, proxy noVNC) n'est protégée que par un Bearer statique, sans
# rotation ni rate-limit : ne l'expose au réseau QUE derrière un reverse-proxy
# authentifiant (modèle du §1). Pour exposer explicitement : OCULAR_BIND=0.0.0.0
# OCULAR_BIND=127.0.0.1
# Token admin : requis pour SUPPRIMER / PURGER des analyses sauvegardées.
# Générer une valeur forte (`openssl rand -base64 32`) et la taper EXACTEMENT
# dans le champ « Token administrateur » de l'UI (page Admin).
# OCULAR_ADMIN_TOKEN=            # vide = admin par token désactivé (503 fail-closed)

# Identité IdP (forward-auth) — OPTIONNEL, désactivé par défaut.
# N'activer QUE derrière un reverse-proxy authentifié qui STRIPPE l'en-tête client (cf. README).
# OCULAR_TRUST_FORWARD_AUTH=1
# OCULAR_FORWARD_USER_HEADER=X-Forwarded-User
# OCULAR_FORWARD_EMAIL_HEADER=X-Forwarded-Email
# Rôle admin via groupe IdP (forward-auth : nécessite OCULAR_TRUST_FORWARD_AUTH=1 + strip proxy
# de X-Forwarded-Groups ; OIDC in-app : alimenté par OCULAR_OIDC_GROUPS_CLAIM).
# OCULAR_ADMIN_GROUP=ocular-admins
# OCULAR_FORWARD_GROUPS_HEADER=X-Forwarded-Groups

# OIDC JWT in-app — OPTIONNEL, désactivé par défaut. Pour un Keycloak/Authentik SANS
# reverse-proxy : le client présente le jeton de l'IdP, Ocular vérifie la signature (JWKS) et
# iss/aud/exp. Les trois variables ISSUER/AUDIENCE/JWKS_URL sont OBLIGATOIRES — s'il en manque
# une, TOUT jeton est refusé (fail-closed). Le JWKS doit être en https (cf. README).
# OCULAR_OIDC_ENABLED=1
# OCULAR_OIDC_ISSUER=https://idp.example/realms/soc
# OCULAR_OIDC_AUDIENCE=ocular
# OCULAR_OIDC_JWKS_URL=https://idp.example/realms/soc/protocol/openid-connect/certs
# IdP interne joignable seulement en clair : à assumer explicitement (MITM = usurpation totale).
# OCULAR_OIDC_ALLOW_INSECURE_JWKS=1
# Claims. Rôles Keycloak : OCULAR_OIDC_GROUPS_CLAIM=realm_access.roles (chemin pointé).
# OCULAR_OIDC_USERNAME_CLAIM=preferred_username
# OCULAR_OIDC_GROUPS_CLAIM=groups
# OCULAR_OIDC_CLOCK_SKEW=60
# OCULAR_OIDC_JWKS_TTL=300
# OCULAR_OIDC_HTTP_TIMEOUT=5
