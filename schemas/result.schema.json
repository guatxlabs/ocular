          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turnstile Solved"
        },
        "challenge": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Challenge"
        }
      },
      "required": [
        "engine"
      ],
      "title": "StealthInfo",
      "type": "object"
    },
    "Triage": {
      "description": "2e avis natif, parallèle au verdict règles (jamais un écrasement).\n`score` 0-100 = priorité « à regarder » ; sa décomposition intégrale est\ndans `signals` (Σ des weight affichés == score). `weights_version` trace le\njeu de poids (BUILTIN ou calibré) ayant produit ce score.",
      "properties": {
        "score": {
          "title": "Score",
          "type": "integer"
        },
        "band": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Band",
          "type": "string"
        },
        "second_opinion": {
          "enum": [
            "benign",
            "suspicious",
            "malicious",
            "unknown"
          ],
          "title": "Second Opinion",
          "type": "string"
        },
        "agrees_with_rules": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Agrees With Rules"
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/TriageSignal"
          },
          "title": "Signals",
          "type": "array"
        },
        "weights_version": {
          "title": "Weights Version",
          "type": "string"
        }
      },
      "required": [
        "score",
        "band",
        "second_opinion",
        "agrees_with_rules",
        "weights_version"
      ],
      "title": "Triage",
      "type": "object"
    },
    "TriageSignal": {
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label",
        "weight"
      ],
      "title": "TriageSignal",
      "type": "object"
    },
    "Truncation": {
      "description": "Marqueur EXPLICITE de ce que le résultat NE contient pas, parce que les\nplafonds anti-OOM ont mordu (cf. `engine.wrapper`). Un résultat amputé sans\nle dire est un angle mort : l'analyste croirait voir tout le trafic d'une\npage qui en a émis cent fois plus. Tous les compteurs à 0 = résultat\ncomplet.\n\nDeux familles distinctes, à ne pas confondre en lisant un résultat :\n  - `*_dropped` = des ÉLÉMENTS ENTIERS manquent (requêtes, messages,\n    détections) — c'est de la preuve absente ;\n  - `text_truncated` = des éléments sont PRÉSENTS mais un de leurs champs\n    texte a été coupé (URL, en-têtes, texte console, titre de page). Le\n    compteur porte sur le nombre de CHAMPS coupés, pas d'entrées ;\n  - `html_chars_dropped` = le document n'a pas été balayé EN ENTIER par\n    l'analyse statique (`engine.static.analysis_window`). Ce n'est ni de la\n    preuve absente ni un champ coupé : c'est une zone du document où AUCUNE\n    détection n'a été cherchée. Sans ce compteur, un verdict « benign » sur\n    un document partiellement analysé serait indiscernable d'un verdict\n    « benign » sur un document lu en entier.",
      "properties": {
        "network_dropped": {
          "default": 0,
          "title": "Network Dropped",
          "type": "integer"
        },
        "console_dropped": {
          "default": 0,
          "title": "Console Dropped",
          "type": "integer"
        },
        "post_data_truncated": {
          "default": 0,
          "title": "Post Data Truncated",
          "type": "integer"
        },
        "findings_dropped": {
          "default": 0,
          "title": "Findings Dropped",
          "type": "integer"
        },
        "text_truncated": {
          "default": 0,
          "title": "Text Truncated",
          "type": "integer"
        },
        "html_chars_dropped": {
          "default": 0,
          "title": "Html Chars Dropped",
          "type": "integer"
        }
      },
      "title": "Truncation",
      "type": "object"
    }
  },
  "properties": {
